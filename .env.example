# Use the SAME Supabase project as HelloWorld_GenAI.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: enables Generate & save. Manual media CRUD works without it.
GEMINI_API_KEY=your-gemini-api-key
# Exact origin for local development / custom production domain.
# On Vercel, the deployment-specific VERCEL_URL is used automatically.
APP_URL=http://localhost:3001
